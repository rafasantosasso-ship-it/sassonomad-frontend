# ConvertKit — API pública (encontrada em Settings > Advanced > API na conta ConvertKit)
VITE_CONVERTKIT_API_KEY=

# ID do formulário do ConvertKit (Grow > Landing Pages & Forms) usado pelo modal
# "Participar da Comunidade". Todo cadastro é genérico (sem segmentação por
# território) e recebe, via automação configurada no ConvertKit, o artigo
# exclusivo de nomadismo digital assim que esse conteúdo existir
# (ver PROMPT_comunidade_final_v2.md).
VITE_CONVERTKIT_FORM_ID=
