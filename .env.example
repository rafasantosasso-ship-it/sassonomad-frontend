# ConvertKit — API pública (encontrada em Settings > Advanced > API na conta ConvertKit)
VITE_CONVERTKIT_API_KEY=

# ID do formulário do ConvertKit (Grow > Landing Pages & Forms) usado pelo modal
# "Participar da Comunidade". O cadastro é só captura de e-mail para avisos
# futuros (newsletter e comunidade completa) — sem entrega automática de
# nenhum material no momento (ver PROMPT_comunidade_sem_artigo.md).
VITE_CONVERTKIT_FORM_ID=

# URL base do back-end do Sasso Nomad (Fase 2/3). Em desenvolvimento local
# aponta pro servidor Express rodando em localhost:3000.
VITE_API_URL=http://localhost:3000
