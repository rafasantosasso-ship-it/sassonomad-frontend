# ConvertKit — API pública (encontrada em Settings > Advanced > API na conta ConvertKit)
VITE_CONVERTKIT_API_KEY=

# IDs das tags do ConvertKit (Grow > Tags), uma por opção de segmentação do
# formulário "Participar da Comunidade". Crie a conta e as tags primeiro,
# depois configure em cada tag a automação que envia o guia gratuito
# correspondente (ver PROMPT_comunidade_convertkit.md).
VITE_CONVERTKIT_TAG_SARDEGNA=
VITE_CONVERTKIT_TAG_CHAPADA=
VITE_CONVERTKIT_TAG_NOMADISMO=
VITE_CONVERTKIT_TAG_CURIOSO=
